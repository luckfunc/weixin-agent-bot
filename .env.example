# ── Provider (optional; only DeepSeek is supported) ──
# PROVIDER=deepseek

# ── DeepSeek API (sk-... from platform.deepseek.com) ──
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=
# DEEPSEEK_THINKING=

# Used when DEEPSEEK_MODEL is unset; if both are set, DEEPSEEK_MODEL wins
# MODEL=deepseek-v4-flash

# ── System prompt ──
# SYSTEM_PROMPT=You are a helpful assistant.

# ── Conversation (per WeChat user) ──
# CHAT_MAX_MESSAGES=50

# ── Saved CLI profile (API key / last choice) ──
# AUTH_STORE_PATH=

# ── WeChat ──
# WEIXIN_TOKEN_PATH=
